# ==============================================================================
# VERCEL PRODUCTION ENVIRONMENT VARIABLES
# In Vercel Project Dashboard -> Settings -> Environment Variables, add:
# ==============================================================================

# Option A: Paste the entire content of your Firebase Service Account JSON file (RECOMMENDED)
# Key: FIREBASE_SERVICE_ACCOUNT_JSON
# Value: {"type":"service_account","project_id":"vmkvec-cse-training",...}

# OR Option B: Add individual fields from the JSON file:
# FIREBASE_PROJECT_ID=vmkvec-cse-training
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@vmkvec-cse-training.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
